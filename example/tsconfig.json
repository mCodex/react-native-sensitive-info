{
	"extends": "@react-native/typescript-config",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["**/node_modules", "**/Pods"],
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"react-native-sensitive-info": ["../src"],
			"react-native-sensitive-info/hooks": ["../src/hooks"],
			"react-native-sensitive-info/errors": ["../src/errors"]
		}
	}
}
